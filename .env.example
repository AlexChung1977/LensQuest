# LensQuest environment
PORT=8787

# auto | local | bing | serpapi
SEARCH_PROVIDER=auto

# Optional cloud providers (leave empty to use local perceptual corpus)
BING_VISUAL_SEARCH_KEY=
BING_VISUAL_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch

SERPAPI_API_KEY=
# Required for SerpAPI Google Lens (needs a publicly reachable image URL)
IMGBB_API_KEY=

# Optional custom SQLite path
# LENSQUEST_DB_PATH=./server/data/lensquest.sqlite

# Desktop (Electron) web URL
LENSQUEST_WEB_URL=http://localhost:5173
